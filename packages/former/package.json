{
  "name": "@former-ui/former",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geprog/former.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "form-builder",
    "forms"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./former-ui.css": "./dist/index.css"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite build --watch --no-emptyOutDir",
    "build": "vite build",
    "prepack": "pnpm build",
    "test": "vitest --pass-with-no-tests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --build --force"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tsconfig/node24": "24.0.6",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "valibot": "1.5.0",
    "vite": "6.4.4",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14",
    "yup": "1.7.1",
    "zod": "4.6.7"
  }
}
